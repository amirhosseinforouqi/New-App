# ─────────────────────────────────────────────────────────────────────────────
# UWA Portal — environment configuration
#
# Copy to .env and fill in. NEVER commit .env.
# Every value here is read through src/lib/env.ts, which fails fast at boot
# if a required variable is missing — no silent misconfiguration.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# Public origin clients reach the portal at. Used to build login links in
# credential emails, so it MUST be the real external URL, not localhost.
APP_URL=https://portal.your-domain.ca
APP_NAME="UWA Mortgage Portal"
NODE_ENV=production

# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotating this invalidates every active session.
SESSION_SECRET=

# ── Database (PIPEDA: provision this instance in a Canadian region) ──────────
# The app connects as a NON-SUPERUSER, NON-OWNER role so row-level security is
# actually enforced. See drizzle/0002_rls.sql and docs/ARCHITECTURE.md.
DATABASE_URL=postgres://uwa_app:CHANGE_ME@localhost:5432/uwa
# Owner/migration role — only used by `npm run db:migrate`.
DATABASE_MIGRATION_URL=postgres://uwa_owner:CHANGE_ME@localhost:5432/uwa
# Set to "require" for managed Postgres providers that terminate TLS.
DATABASE_SSL=disable

# ── Outbound email (SMTP on your own domain mailbox) ─────────────────────────
# Google Workspace: smtp.gmail.com:465, secure, and an App Password
# (not your login password) as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@your-domain.ca
SMTP_PASSWORD=
MAIL_FROM_NAME="Your Name — Mortgage Broker"
MAIL_FROM_ADDRESS=you@your-domain.ca
# Where client replies should go if different from the From address.
MAIL_REPLY_TO=you@your-domain.ca

# ── Inbound email (IMAP polling — creates client profiles automatically) ─────
# Same mailbox, read side. The worker watches INBOX, and files processed mail
# into IMAP_PROCESSED_FOLDER so it is never handled twice.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@your-domain.ca
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_PROCESSED_FOLDER=UWA/Processed
# Seconds between polls when IDLE is unavailable.
IMAP_POLL_INTERVAL=60
# Comma-separated addresses/domains that must NEVER auto-create a client
# (newsletters, no-reply senders, your own team).
INBOUND_IGNORE_LIST=no-reply@,noreply@,mailer-daemon@,postmaster@

# ── Google Drive (Workspace Shared Drive + service account) ──────────────────
# See docs/GOOGLE_DRIVE_SETUP.md for the click-by-click setup.
# Path to the service account JSON key file, OR paste the JSON into
# GOOGLE_SERVICE_ACCOUNT_JSON (base64) for container deploys. One or the other.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/uwa-drive-sa.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# The Shared Drive ID (from its URL: drive.google.com/drive/folders/<ID>).
GOOGLE_SHARED_DRIVE_ID=
# Folder inside the Shared Drive that holds one subfolder per client.
# Leave blank to use the Shared Drive root.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── SMS reminders (optional — Twilio) ───────────────────────────────────────
# Leave blank and document reminders fall back to email. Nothing is ever
# reported as sent that was not; see src/lib/notify/sms.ts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be a number you own in Twilio, in E.164 form.
TWILIO_FROM_NUMBER=

# ── Anthropic (agent skills layer) ──────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model used for mortgage processing skills.
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max — see docs/AGENT_SKILLS.md
ANTHROPIC_EFFORT=high

# ── Uploads ─────────────────────────────────────────────────────────────────
# Per-file ceiling in bytes (25 MB default). Files stream straight to Drive;
# nothing is written to the app's local disk.
MAX_UPLOAD_BYTES=26214400
